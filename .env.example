# Server
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
EMAIL_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm
DATABASE_URL=postgresql://postgres:password@localhost:5432/uno
DATABASE_SSL=false
AVATAR_STORAGE_PATH=uploads/avatars
# Set this only on the server. Never add it to VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=
TURN_SECONDS=30

# Client - the anon key is the only Supabase value allowed in client code.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
